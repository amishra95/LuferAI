# Supabase — from `npx supabase start` (local) or Project Settings → API (hosted).
# Leave blank to run the portals on the built-in mock data (mirrors supabase/seed.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI venue sourcing + event briefs (server-only). Without it the AI features
# return a "not configured" message and the rest of the app works as before.
OPENAI_API_KEY=
# Optional: override the default model (lib/ai/model.ts).
OPENAI_MODEL=

# WhatsApp Business (Cloud API) — POST/GET /api/webhooks/whatsapp. Server-only.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: Graph API version for outbound replies (default v23.0).
WHATSAPP_GRAPH_VERSION=

# Slack bot (Events API) — POST /api/webhooks/slack. Server-only.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
