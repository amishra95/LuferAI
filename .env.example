# =============================================================================
# Environment reference. Copy to .env.local for development; set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
#   [required]  the app (or that feature) fails closed without it
#   [optional]  feature degrades gracefully or a default applies
#   NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time —
#   change them, then rebuild/redeploy. Everything else is server-only.
# =============================================================================

# --- Supabase (auth, data, RLS) ------------------------------------------------
# From `npx supabase start` (local) or Project Settings → API (hosted).
# [required] Without these the portals redirect to /login ("Sign-in is unavailable").
# Values are whitespace-stripped (lib/supabase/env.ts); a malformed URL falls back to mock data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [required] Server-only; bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# [optional] Public base URL for auth redirects and payment return URLs.
# Defaults to the request origin; set it in production (e.g. https://app.example.com).
NEXT_PUBLIC_SITE_URL=

# [optional] Google OAuth for the LOCAL Supabase stack (supabase/config.toml).
# Hosted Supabase: set under Authentication → Providers → Google instead.
# Authorised redirect URI in Google Cloud: <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Scheduled jobs ----------------------------------------------------------------
# [required in production] Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/* (hold expiry, lapsed venue responses). Unset → cron requests get 401.
CRON_SECRET=

# --- Upstash Redis: rate limiting + checkout slot locks ----------------------------
# Rate limiting: /api/ai/* at 10 req/min per user or IP.
# Slot locks (lib/locks): a venue/date is locked for 10 min while someone completes the
# booking form, and for 30 s around each submit, across all server instances.
# [optional, set in production] Unset → no rate limiting, and slot locks fall back to
# per-instance memory (the inventory_holds trigger still prevents double bookings).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payments (deposit authorised on request, captured when the venue confirms) ----
# [optional] razorpay | stripe. Unset → first provider with keys (Razorpay, then Stripe);
# no keys at all → deposit buttons are hidden.
PAYMENT_PROVIDER=
# Webhook URL for both providers: <site>/api/payments/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI (venue search, event briefs, RFP broadcast, negotiator) via OpenAI ---------
# [required for AI features] Server-only. Unset → AI routes answer "not configured"
# and the rest of the app works as before.
OPENAI_API_KEY=
# [optional] Override the default model (lib/ai/model.ts).
OPENAI_MODEL=
# [required for the negotiator] HMAC key for tool approvals so a modified client can't
# forge one. Generate: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# --- Venue map (MapLibre + MapTiler) -------------------------------------------------
# [optional] Unset → the map shows a placeholder; the venue list still works.
NEXT_PUBLIC_MAPTILER_KEY=
# [optional] MapTiler style id; default dataviz-dark.
NEXT_PUBLIC_MAPTILER_STYLE=

# --- Native apps (Capacitor) — build-time, used by `npm run cap:sync` only ----------
# [required for cap:sync] The site the iOS/Android WebView loads. HTTPS for releases;
# http://<LAN-IP>:3000 only for device testing against `next dev -H 0.0.0.0`.
CAP_SERVER_URL=

# ---------------------------------------------------------------------------
# Channels (WhatsApp + Slack). Full walkthrough: docs/channels.md
# Webhooks: GET/POST /api/webhooks/whatsapp, POST /api/webhooks/slack.
# With Supabase configured, sender links and message logs are stored in the
# tables from supabase/migrations/20261007120000_channel_integrations.sql.
# ---------------------------------------------------------------------------

# Public https origin Meta/Slack can reach. In local development, your tunnel:
#   ngrok http 3000   →   PUBLIC_BASE_URL=https://<id>.ngrok-free.app
# Settings → Channels shows webhook URLs built from this. No trailing slash.
PUBLIC_BASE_URL=

# WhatsApp Business (Cloud API). Server-only.
# Meta app → WhatsApp → Configuration → Webhook:
#   Callback URL  = $PUBLIC_BASE_URL/api/webhooks/whatsapp
#   Verify token  = WHATSAPP_VERIFY_TOKEN (any string you choose)
#   Subscribe to the "messages" field.
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# System-user token with whatsapp_business_messaging (WhatsApp → API setup gives a 24h test token).
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API setup → Phone number ID (replies are sent from this number).
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version for outbound replies.
WHATSAPP_GRAPH_VERSION=v23.0

# Slack bot (Events API). Server-only.
# api.slack.com/apps → your app:
#   Basic Information → Signing Secret          → SLACK_SIGNING_SECRET
#   OAuth & Permissions → Bot scopes: chat:write, app_mentions:read, im:history
#   Install to workspace → Bot User OAuth Token → SLACK_BOT_TOKEN (xoxb-…)
#   Event Subscriptions → Request URL = $PUBLIC_BASE_URL/api/webhooks/slack
#     Bot events: app_mention, message.im
#   App Home → enable "Allow users to send Slash commands and messages from the messages tab"
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Finance sync: when a venue confirms a booking, a structured JSON receipt
# (schema lufer.expense-receipt/v1) is exported and logged in expense_exports.
# Without a URL the export is mocked: recorded and logged, not sent.
# ---------------------------------------------------------------------------
EXPENSE_WEBHOOK_URL=
# Optional HMAC key: requests carry X-Lufer-Signature: sha256=<hmac of body>.
EXPENSE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Federated partner directory. Without a URL a built-in demo network
# (Bengaluru Venue Exchange) is used. The feed must return a JSON array of
# { ref, name, area, city, address?, capacity, min_spend_inr, private_dining? }.
# ---------------------------------------------------------------------------
PARTNER_DIRECTORY_URL=
PARTNER_DIRECTORY_NAME=
