# =============================================================================
# Environment reference. Copy to .env.local for development; set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
#   [required]  the app (or that feature) fails closed without it
#   [optional]  feature degrades gracefully or a default applies
#   NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time —
#   change them, then rebuild/redeploy. Everything else is server-only.
# =============================================================================

# --- Supabase (auth, data, RLS) ------------------------------------------------
# From `npx supabase start` (local) or Project Settings → API (hosted).
# [required] Without these the portals redirect to /login ("Sign-in is unavailable").
# Values are whitespace-stripped (lib/supabase/env.ts); a malformed URL falls back to Redis/mock data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [required] Server-only; bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# [optional] Public base URL for auth redirects and payment return URLs.
# Defaults to the request origin; set it in production (e.g. https://app.example.com).
NEXT_PUBLIC_SITE_URL=

# [optional] Sentry error tracking (lib/observability/sentry.ts). Off until a DSN is set.
# The Vercel Sentry integration sets all five; SENTRY_AUTH_TOKEN enables source map upload at build.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# [optional] Google OAuth for the LOCAL Supabase stack (supabase/config.toml).
# Hosted Supabase: set under Authentication → Providers → Google instead.
# Authorised redirect URI in Google Cloud: <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Scheduled jobs ----------------------------------------------------------------
# [required in production] Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/* (hold expiry, lapsed venue responses). Unset → cron requests get 401.
CRON_SECRET=

# --- Upstash Redis: telemetry, rate limiting, slot locks, fallback data store ------
# Telemetry (lib/telemetry/runs.ts): every agent run (chat, WhatsApp/Slack, /api/ai/*,
#   agent tests) is logged under lufer:telemetry:*; the Overview metrics, activity feed
#   and Agents page run counts are computed from it.
# Rate limiting: /api/ai/* at 10 req/min per user or IP.
# Slot locks (lib/locks): a venue/date is locked for 10 min while someone completes the
#   booking form, and for 30 s around each submit, across all server instances.
# Data store (lib/data/local-store.ts): only when Supabase is NOT configured, venues,
#   bookings, approvals, holds and exports live in lufer:db:* hashes, seeded once from
#   the demo data. Note portal sign-in still needs Supabase.
# [optional, set in production] Unset → telemetry and data are per-instance memory, no
# rate limiting, and slot locks are per instance (the inventory_holds trigger still
# prevents double bookings).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payments (deposit authorised on request, captured when the venue confirms) ----
# [optional] razorpay | stripe. Unset → first provider with keys (Razorpay, then Stripe);
# no keys at all → deposit buttons are hidden.
PAYMENT_PROVIDER=
# Webhook URL for both providers: <site>/api/payments/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Contract e-signatures (lib/services/contracts). Unset: contracts are signed in the app.
# dropbox_sign: send agreements through Dropbox Sign. Set the account callback URL to
# <site>/api/contracts/webhooks/dropbox-sign. Test mode is on unless DROPBOX_SIGN_TEST_MODE=0.
CONTRACT_SIGNING_PROVIDER=
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEST_MODE=

# --- Marketplace payouts (catalogue orders; lib/marketplace) ---
# Catalogue orders are paid in full through Razorpay and split to each partner's
# Route linked account (enable Route on the Razorpay account, and subscribe the
# webhook to transfer.processed, transfer.failed, transfer.reversed).
# The platform's own GSTIN: it invoices its commission under it and collects
# Section 52 TCS (needs the e-commerce operator TCS registration). Order
# payments stay off until this is a valid GSTIN.
PLATFORM_GSTIN=

# --- AI (venue search, event briefs, RFP broadcast, negotiator) via OpenAI ---------
# [required for AI features] Server-only. Unset → AI routes answer "not configured"
# and the rest of the app works as before.
OPENAI_API_KEY=
# [optional] Override the default model (lib/ai/model.ts).
OPENAI_MODEL=
# [optional] Server-only. Enables the Claude Sonnet 5.5 backend that agents can be
# switched to on /agents. Unset → that backend shows "API key not set here".
ANTHROPIC_API_KEY=
# [optional] Server-only. Groq, the fast fallback tier: when OpenAI and Anthropic are
# both down or slow, model calls fail over to it (lib/ai/routing.ts).
GROQ_API_KEY=
# [optional] Override the Groq model (default llama-3.3-70b-versatile).
GROQ_MODEL=
# [required for the negotiator] HMAC key for tool approvals so a modified client can't
# forge one. Generate: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# --- Venue map (MapLibre + MapTiler) -------------------------------------------------
# [optional] Unset → the map shows a placeholder; the venue list still works.
NEXT_PUBLIC_MAPTILER_KEY=
# [optional] MapTiler style id; default streets-v2 (e.g. dataviz, streets-v2-dark).
NEXT_PUBLIC_MAPTILER_STYLE=

# --- Native apps (Capacitor) — build-time, used by `npm run cap:sync` only ----------
# [required for cap:sync] The site the iOS/Android WebView loads. HTTPS for releases;
# http://<LAN-IP>:3000 only for device testing against `next dev -H 0.0.0.0`.
CAP_SERVER_URL=

# ---------------------------------------------------------------------------
# Channels (WhatsApp + Slack). Full walkthrough: docs/channels.md
# Webhooks: GET/POST /api/webhooks/whatsapp, POST /api/webhooks/slack.
# With Supabase configured, sender links and message logs are stored in the
# tables from supabase/migrations/20261007120000_channel_integrations.sql.
# ---------------------------------------------------------------------------

# Public https origin Meta/Slack can reach. In local development, your tunnel:
#   ngrok http 3000   →   PUBLIC_BASE_URL=https://<id>.ngrok-free.app
# Settings → Channels shows webhook URLs built from this. No trailing slash.
PUBLIC_BASE_URL=

# [optional] Zero-login quote links for venues (app/(vendor)/quote/[token], lib/vendor):
# each venue an RFP goes to gets a 7-day link, on its alert WhatsApp number, to adjust its
# price and inclusions or decline from a phone. Signs the links: `openssl rand -base64 32`.
# Rotating it revokes every link. Unset → no links. Needs Supabase (RFPs live there).
VENDOR_LINK_SECRET=

# WhatsApp Business (Cloud API). Server-only.
# Meta app → WhatsApp → Configuration → Webhook:
#   Callback URL  = $PUBLIC_BASE_URL/api/webhooks/whatsapp
#   Verify token  = WHATSAPP_VERIFY_TOKEN (any string you choose)
#   Subscribe to the "messages" field.
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# System-user token with whatsapp_business_messaging (WhatsApp → API setup gives a 24h test token).
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API setup → Phone number ID (replies are sent from this number).
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version for outbound replies.
WHATSAPP_GRAPH_VERSION=v23.0
# [optional] Spend approvals on WhatsApp (lib/approvals/whatsapp.ts): when a step is an
# approver's turn they get the request with [Approve] / [Reject] buttons on the number
# linked to them in Settings → Channels. Signs the button IDs: `openssl rand -base64 32`.
# Unset → no WhatsApp approvals (the web queue works as before).
WHATSAPP_APPROVAL_SECRET=
# [optional] Meta delivers interactive buttons only within 24 h of the approver's last
# message to the business number. To reach them any time, name an approved template with
# one body variable ({{1}}) and two quick-reply buttons (Approve, then Reject).
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_APPROVAL_TEMPLATE_LANG=en

# Slack bot (Events API). Server-only.
# api.slack.com/apps → your app:
#   Basic Information → Signing Secret          → SLACK_SIGNING_SECRET
#   OAuth & Permissions → Bot scopes: chat:write, app_mentions:read, im:history
#   Install to workspace → Bot User OAuth Token → SLACK_BOT_TOKEN (xoxb-…)
#   Event Subscriptions → Request URL = $PUBLIC_BASE_URL/api/webhooks/slack
#     Bot events: app_mention, message.im
#   App Home → enable "Allow users to send Slash commands and messages from the messages tab"
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Finance sync: when a venue confirms a booking, a structured JSON receipt
# (schema lufer.expense-receipt/v1) is exported and logged in expense_exports.
# Without a URL the export is mocked: recorded and logged, not sent.
# ---------------------------------------------------------------------------
EXPENSE_WEBHOOK_URL=
# Optional HMAC key: requests carry X-Lufer-Signature: sha256=<hmac of body>.
EXPENSE_WEBHOOK_SECRET=
# Expense/ERP providers (receipts and card events go to the company's provider;
# lib/finance/expense-adapters.ts providerConnection). Unset URL = mocked.
# Ramp, Brex, SAP Concur: <PROVIDER>_API_TOKEN sent as a bearer token.
RAMP_EXPENSE_URL=
RAMP_API_TOKEN=
BREX_EXPENSE_URL=
BREX_API_TOKEN=
CONCUR_EXPENSE_URL=
CONCUR_API_TOKEN=
# Zoho Expense: POST endpoint for one expense, e.g. https://expense.zoho.com/api/v1/expenses,
# on your org's data centre (.in for India). The OAuth access token is sent as
# "Zoho-oauthtoken <token>" (access tokens expire after an hour). ZOHO_API_TOKEN
# is still read if ZOHO_EXPENSE_AUTH_TOKEN is unset.
ZOHO_EXPENSE_URL=
ZOHO_EXPENSE_AUTH_TOKEN=
ZOHO_EXPENSE_ORGANIZATION_ID=
# ERPNext: e.g. https://<site>/api/resource/Purchase Invoice (the space is encoded).
# Sent as "Authorization: token <key>:<secret>". ERPNEXT_EXPENSE_URL is still read.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# [optional] OAuth token vault (lib/auth/oauth-vault.ts): Zoho and ERPNext tokens are
# stored in oauth_credentials encrypted with AES-256-GCM under this key, and
# refreshed before they expire (lib/auth/token-rotator.ts, /api/cron/rotate-oauth-tokens).
# 32 bytes: `openssl rand -base64 32`. Unset → the vault is off and the env tokens
# above are used as before. Changing it makes stored tokens unreadable: re-seed them.
OAUTH_VAULT_KEY=
# Zoho OAuth client (api-console.zoho.com, "Self Client" or server-based app). The
# refresh token seeds the vault once; after that the vault's copy is used.
# ZOHO_ACCOUNTS_URL: your data centre's accounts server (default https://accounts.zoho.com;
# e.g. https://accounts.zoho.in, https://accounts.zoho.eu).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=
# ERPNext over OAuth (Frappe → OAuth Client). Optional: without a client ID, the
# API key/secret above is used and nothing is rotated. Frappe rotates the refresh
# token on each use, so this one only seeds the vault. Token URL defaults to
# <ERPNEXT_URL origin>/api/method/frappe.integrations.oauth2.get_token.
ERPNEXT_OAUTH_CLIENT_ID=
ERPNEXT_OAUTH_CLIENT_SECRET=
ERPNEXT_OAUTH_REFRESH_TOKEN=
ERPNEXT_OAUTH_TOKEN_URL=
# Inbound POST /api/webhooks/expense (card.settled, booking.confirmed) must be
# signed with this key (X-Lufer-Signature). Unset: the endpoint returns 503.
EXPENSE_INBOUND_SECRET=

# ---------------------------------------------------------------------------
# Federated partner directory. Without a URL a built-in demo network
# (Bengaluru Venue Exchange) is used. The feed must return a JSON array of
# { ref, name, area, city, address?, capacity, min_spend_inr, private_dining? }.
# ---------------------------------------------------------------------------
PARTNER_DIRECTORY_URL=
PARTNER_DIRECTORY_NAME=

# AI Concierge (/api/agent/chat): Gemini via @ai-sdk/google
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Gemini model for agent routes and the concierge (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional: faster Gemini model for the workspace chat (default gemini-3.1-flash-lite)
GEMINI_FAST_MODEL=

# Concierge connectors (all optional; each tool degrades gracefully without its keys)
# Google Calendar free/busy via a service account (domain-wide delegation, or calendars shared with it)
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
# Workspace user to act as (domain-wide delegation only)
GOOGLE_CALENDAR_SUBJECT=
# WhatsApp confirmations use the WHATSAPP_* Meta Cloud API keys above; else Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender, +E.164
TWILIO_WHATSAPP_FROM=
# [optional] WhatsApp approvals over Twilio (when the Meta keys above aren't set): a Content
# template (quick-reply) with body {{1}} and button IDs {{2}} (Approve) and {{3}} (Reject).
# Point the sender's "when a message comes in" webhook at $PUBLIC_BASE_URL/api/webhooks/whatsapp.
TWILIO_APPROVAL_CONTENT_SID=
# [optional] The exact webhook URL configured in Twilio, if it differs from what the server
# sees (a proxy or tunnel). Twilio signs this URL; a mismatch fails every callback with 401.
TWILIO_WEBHOOK_URL=
# Partner supplier availability API: GET ?ref=&from=&to=&party_size= → [{ date, available, slots }]
PARTNER_INVENTORY_URL=
# Slack channel the concierge posts approval reminders to (needs SLACK_BOT_TOKEN), e.g. C0123456789
APPROVALS_SLACK_CHANNEL=

# cXML punchout: our identity on carts returned to buyers' procurement systems (default lufer.app).
# PUNCHOUT_SUPPLIER_IDENTITY=lufer.app
